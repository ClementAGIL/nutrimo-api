{
  "name": "nutrimo-api",
  "version": "0.1.0",
  "private": true,
  "description": "Nutrimo food search API (Open Food Facts France + CIQUAL) on PostgreSQL",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "check": "tsc --noEmit && prettier --check .",
    "format": "prettier --write .",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "import:ciqual": "tsx src/scripts/importCiqual.ts",
    "import:off": "tsx src/scripts/importOff.ts",
    "export:ciqual-json": "tsx src/scripts/exportCiqualJson.ts"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "fastify": "^5.12.7",
    "postgres": "^3.4.9",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
